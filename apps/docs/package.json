{
  "name": "@objectstack/docs",
  "version": "4.2.2",
  "private": true,
  "description": "ObjectStack Protocol Documentation Site",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @objectstack/spec gen:schema && pnpm --filter @objectstack/spec gen:docs && NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "site:lint": "next lint",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@objectstack/spec": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "negotiator": "^1.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
