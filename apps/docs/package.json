{
  "name": "@objectstack/docs",
  "version": "4.2.3",
  "private": true,
  "description": "ObjectStack Protocol Documentation Site",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @objectstack/spec gen:schema && pnpm --filter @objectstack/spec gen:docs && NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "site:lint": "next lint",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.15",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.15",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.16.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@objectstack/spec": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "negotiator": "^1.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
