# The showcase ships three kind:'react' pages (crm-workbench, renewals-pipeline,
# task-desk). That tier runs page source in the browser and is off unless a
# deployment turns it on, so this example opts in. `os dev`, `os serve` and
# `os start` read this file from the project root.
OS_PAGE_REACT_ENABLED=true

# The organization's home currency (Setup → Localization → Default currency).
# The invoice is the multi-currency example: it converts each invoice into the
# home currency at write, from the exchange rates the seed loads, and those
# rates are stated against USD. So the home currency is pinned here rather than
# derived from this host's locale: a host with no locale would otherwise leave
# it unset, and every seeded invoice would be refused (ERR_HOME_CURRENCY_UNSET).
# Pinned by environment, the Localization page shows it locked; edit this line
# (and the seeded rates) to run the example in another home currency.
OS_LOCALIZATION_CURRENCY=USD
