{
  "name": "@objectstack/platform-objects",
  "version": "17.2.0",
  "license": "Apache-2.0",
  "description": "Core platform object schemas for ObjectStack — identity, security, audit, tenant, and metadata objects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity/index.d.mts",
        "default": "./dist/identity/index.mjs"
      },
      "require": {
        "types": "./dist/identity/index.d.ts",
        "default": "./dist/identity/index.js"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security/index.d.mts",
        "default": "./dist/security/index.mjs"
      },
      "require": {
        "types": "./dist/security/index.d.ts",
        "default": "./dist/security/index.js"
      }
    },
    "./audit": {
      "import": {
        "types": "./dist/audit/index.d.mts",
        "default": "./dist/audit/index.mjs"
      },
      "require": {
        "types": "./dist/audit/index.d.ts",
        "default": "./dist/audit/index.js"
      }
    },
    "./integration": {
      "import": {
        "types": "./dist/integration/index.d.mts",
        "default": "./dist/integration/index.mjs"
      },
      "require": {
        "types": "./dist/integration/index.d.ts",
        "default": "./dist/integration/index.js"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata/index.d.mts",
        "default": "./dist/metadata/index.mjs"
      },
      "require": {
        "types": "./dist/metadata/index.d.ts",
        "default": "./dist/metadata/index.js"
      }
    },
    "./system": {
      "import": {
        "types": "./dist/system/index.d.mts",
        "default": "./dist/system/index.mjs"
      },
      "require": {
        "types": "./dist/system/index.d.ts",
        "default": "./dist/system/index.js"
      }
    },
    "./apps": {
      "import": {
        "types": "./dist/apps/index.d.mts",
        "default": "./dist/apps/index.mjs"
      },
      "require": {
        "types": "./dist/apps/index.d.ts",
        "default": "./dist/apps/index.js"
      }
    },
    "./pages": {
      "import": {
        "types": "./dist/pages/index.d.mts",
        "default": "./dist/pages/index.mjs"
      },
      "require": {
        "types": "./dist/pages/index.d.ts",
        "default": "./dist/pages/index.js"
      }
    },
    "./metadata-translations": {
      "import": {
        "types": "./dist/metadata-translations/index.d.mts",
        "default": "./dist/metadata-translations/index.mjs"
      },
      "require": {
        "types": "./dist/metadata-translations/index.d.ts",
        "default": "./dist/metadata-translations/index.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/check-dts-emitted.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@objectstack/metadata-core": "workspace:*",
    "@objectstack/spec": "workspace:*"
  },
  "devDependencies": {
    "@objectstack/core": "workspace:*",
    "@objectstack/formula": "workspace:*",
    "@objectstack/lint": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "objectstack",
    "platform-objects",
    "schema",
    "identity",
    "security",
    "tenant"
  ],
  "author": "ObjectStack",
  "repository": {
    "type": "git",
    "url": "https://github.com/objectstack-ai/objectstack.git",
    "directory": "packages/platform-objects"
  },
  "homepage": "https://objectstack.ai/docs",
  "bugs": "https://github.com/objectstack-ai/objectstack/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
