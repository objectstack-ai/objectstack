{
  "name": "@objectstack/service-record-context",
  "version": "19.0.0-next.2",
  "license": "Apache-2.0",
  "description": "Record context service for ObjectStack — the context-pack (ai_context) render service and the get_record_context tool executor, reading one record AS THE CALLER (ADR-0160).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup --config ../../../tsup.config.ts && node ../../../scripts/check-dts-emitted.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm check:test-typecheck",
    "check:test-typecheck": "tsx ../../../scripts/check-test-typecheck.mts --self-test && tsx ../../../scripts/check-test-typecheck.mts --package packages/services/service-record-context --project tsconfig.test.json"
  },
  "dependencies": {
    "@objectstack/core": "workspace:*",
    "@objectstack/spec": "workspace:*",
    "@objectstack/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "objectstack",
    "service",
    "ai",
    "context",
    "mcp",
    "record"
  ],
  "author": "ObjectStack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objectstack-ai/objectstack.git",
    "directory": "packages/services/service-record-context"
  },
  "homepage": "https://objectstack.ai/docs",
  "bugs": "https://github.com/objectstack-ai/objectstack/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
