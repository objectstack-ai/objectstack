{
  "name": "@objectstack/service-knowledge",
  "version": "19.0.0-next.1",
  "license": "Apache-2.0",
  "description": "Knowledge Service for ObjectStack — orchestrator implementing IKnowledgeService over pluggable IKnowledgeAdapter backends (in-memory, PostgreSQL + pgvector, libSQL, or your own).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node ../../../scripts/check-dts-emitted.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm check:test-typecheck",
    "check:test-typecheck": "tsx ../../../scripts/check-test-typecheck.mts --self-test && tsx ../../../scripts/check-test-typecheck.mts --package packages/services/service-knowledge --project tsconfig.test.json"
  },
  "dependencies": {
    "@objectstack/core": "workspace:*",
    "@objectstack/embedder-openai": "workspace:*",
    "@objectstack/service-settings": "workspace:*",
    "@objectstack/spec": "workspace:*"
  },
  "devDependencies": {
    "@objectstack/driver-sql": "workspace:*",
    "@objectstack/objectql": "workspace:*",
    "@objectstack/platform-objects": "workspace:*",
    "@objectstack/service-queue": "workspace:*",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "objectstack",
    "service",
    "knowledge",
    "rag",
    "vector",
    "retrieval"
  ],
  "author": "ObjectStack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objectstack-ai/objectstack.git",
    "directory": "packages/services/service-knowledge"
  },
  "homepage": "https://objectstack.ai/docs",
  "bugs": "https://github.com/objectstack-ai/objectstack/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
