{
  "name": "@objectstack/service-mailbox",
  "version": "18.1.0",
  "license": "Apache-2.0",
  "description": "Mailbox Service for ObjectStack \u2014 inbound mail: the mirrored message (sys_mail_message), its record associations and their read gates.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup --config ../../../tsup.config.ts && node ../../../scripts/check-dts-emitted.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@objectstack/connector-imap": "workspace:*",
    "@objectstack/core": "workspace:*",
    "@objectstack/platform-objects": "workspace:*",
    "@objectstack/spec": "workspace:*",
    "@objectstack/types": "workspace:*",
    "postal-mime": "^4.0.8"
  },
  "devDependencies": {
    "@objectstack/driver-sql": "workspace:*",
    "@objectstack/lint": "workspace:*",
    "@objectstack/objectql": "workspace:*",
    "@objectstack/service-storage": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "objectstack",
    "service",
    "mailbox",
    "inbound-mail",
    "email"
  ],
  "author": "ObjectStack",
  "repository": {
    "type": "git",
    "url": "https://github.com/objectstack-ai/objectstack.git",
    "directory": "packages/services/service-mailbox"
  },
  "homepage": "https://objectstack.ai/docs",
  "bugs": "https://github.com/objectstack-ai/objectstack/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
