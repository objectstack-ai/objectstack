{
  "name": "@objectstack/core",
  "version": "17.1.0",
  "license": "Apache-2.0",
  "description": "Microkernel Core for ObjectStack",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@objectstack/metadata-core": "workspace:*",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@objectstack/spec": "workspace:*",
    "zod": "^4.4.3"
  },
  "keywords": [
    "objectstack",
    "kernel",
    "microkernel",
    "plugin",
    "dependency-injection",
    "event-bus"
  ],
  "author": "ObjectStack",
  "repository": {
    "type": "git",
    "url": "https://github.com/objectstack-ai/objectstack.git",
    "directory": "packages/core"
  },
  "homepage": "https://objectstack.ai/docs",
  "bugs": "https://github.com/objectstack-ai/objectstack/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
