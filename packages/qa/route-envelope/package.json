{
  "name": "@objectstack/route-envelope-conformance",
  "version": "0.0.1-rc.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared response-envelope conformance guard (#3843) — one source-scanning check that fails any route module emitting a body outside BaseResponseSchema. Replaces the hand-rolled scan copied into service-storage and service-i18n. Not published; validation instrument, zero runtime dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config ../../../tsup.config.ts",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "objectstack",
    "qa",
    "conformance",
    "envelope",
    "static-analysis"
  ],
  "author": "ObjectStack",
  "repository": {
    "type": "git",
    "url": "https://github.com/objectstack-ai/objectstack.git",
    "directory": "packages/qa/route-envelope"
  },
  "homepage": "https://objectstack.ai/docs",
  "bugs": "https://github.com/objectstack-ai/objectstack/issues"
}
