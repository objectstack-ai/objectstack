    "SemanticRelevance (type)",
    "SemanticRelevanceKey (type)",
    "SpecChanges (type)",
    "SpecChangesSchema (const)",
    "SpecConverted (type)",
    "SpecConvertedSchema (const)",
    "SpecMigrated (type)",
    "SpecMigratedSchema (const)",
    "SpecReleaseChanges (type)",
