/**
 * The permanent metadata migration chain (ADR-0087 D3).
 *
 * One {@link MigrationStep} per protocol major that carried a break. Each step's
 * mechanical transforms are the D2 conversions that graduated into it (referenced
 * by id, so the transform + fixture pair are never duplicated), and its
 * `semantic` list carries one entry per retirement family, even when a lossless
 * D2 conversion also exists for it — D2 carries the mechanical data repair only.
 *
 * The chain is a **rolling artifact** (ADR-0087 amendment 2026-10-26, #25767):
 * every step back to {@link MIGRATION_SUPPORT_FLOOR} stays replayable, and CI
 * replays the full chain from the oldest supported major's fixtures to current
 * on every release (`migrations.test.ts`). A retirement kit — the tombstone, its
 * `RETIRED_KEYS_BY_MAJOR` / `RETIRED_DEFS_BY_MAJOR` entries, its semantic entry
 * and its conversion — lives ONE protocol major past the one it retired in and
 * is then removed whole: at major 18 the 17.x and 18.x kits stay and the ≤16.x
 * ones went. After the removal the key is refused as a strict unknown key and
 * the refusal names the upgrade guide; nothing converts it. The support floor is
 * the same knob, read the other way — how far back `migrate meta --from N`
 * reaches — and it rises with each major so that the two never disagree.
 *
 * ## ⚠️ `registry.ts` is GENERATED WHOLE and git-ignored (#7297, #22554)
 *
 * `gen:migration-registry` writes it from `./registry.ts.template` (everything
 * outside the `<os-generated …>` markers) and `./entries/` (each step's
 * `semantic` list and the two RETIRED tables: one file per entry, sorted by id),
 * on install and as the first step of `build`. Add an entry by adding a FILE
 * (`./entries/README.md`); edit anything else in the TEMPLATE. An edit to
 * `registry.ts` itself is never committed, and the next generation overwrites it.
 *
 * They were three hand-authored APPEND tables, and every retirement card
 * appended to the same tail line of the same two of them: `step17`'s semantic
 * list and `RETIRED_KEYS_BY_MAJOR[17]` conflicted in **6 of 11** contended
 * re-merge laps over 2026-08-06..10, for 613 hand-resolved lines of conflict
 * markers in four days (#6957's measurement, ruling adopted 2026-08-10). The
 * danger was never the wall-clock: **both tables are consumed as sets**, so a
 * resolution that drops a sibling's entry produces no error anywhere and the
 * retirement it declared silently stops being declared.
 *
 * Everything OUTSIDE the markers — this header, each step's `rationale` and
 * `conversionIds`, and the two tables' load-bearing doc comments — is
 * hand-written in the template and merges there as text. Step 18 is shaped for
 * that merge (#20535): its `rationale` is fragments kept sorted by key, so two
 * retirements insert at different lines ({@link STEP18_RATIONALE}), and its
 * `conversionIds` is derived rather than kept as a second copy.
 */

// A VALUE import for the generated regions: an entry literal below derives its
// group enumeration from this schema's own keys rather than restating them
// (`translation-per-app-settings-platform-only`). Entry files carry their own
// copy of this import, but the generator treats a file's imports as scaffolding
// and concatenates only the literal — so an entry that references a value needs
// that value in scope HERE, hand-written, outside the generated regions.
import { TranslationDataSchema } from '../system/translation.zod.js';
// The other VALUE import: step 18's `conversionIds` is read off the list the
// loader applies instead of being restated here (see `step18`).
import { CONVERSIONS_BY_MAJOR } from '../conversions/registry.js';
import type { MigrationStep } from './types.js';

/**
 * The oldest protocol major the chain guarantees a replayable path from.
 * `objectstack migrate meta --from N` supports any `N >= MIGRATION_SUPPORT_FLOOR`.
 * A release-policy decision (ADR-0087 D3), not an accident of what still exists.
 *
 * Raised 10 → 16 by maintainer ruling, 2026-09-18 (#19056), verbatim and
 * untranslated:
 *
 * > 升级只需要支持从 16.0版本开始。
 *
 * Raised 16 → 17 by maintainer ruling, 2026-10-26 (#25767, ADR-0087 amendment,
 * D2 = A): a retirement kit lives one protocol major past the one it retired
 * in. At major 18 that keeps the 17.x and 18.x kits and removes the ≤16.x ones,
 * and the floor follows: `os migrate meta --from 16` (and below) is refused
 * with the upgrade-guide link and converts nothing. The next major repeats the
 * move — `CURRENT_MAJOR - 1` is the floor, not a number chosen per release.
 *
 * Raising it is what RETIRES the steps below it: `step11`–`step16` went with
 * the first move and `step17` with the second, because a step the floor no
 * longer reaches is replayed by nothing and CI stops proving it still works —
 * dead code that reads as a promise. `applyMetaMigrations(doc, N)` throws
 * `MigrationFloorError` for N < 17; those consumers reach 17 by another path
 * first (a release that still carried the step, e.g. @objectstack/spec 18.1).
 *
 * ⚠️ The floor scopes the CHAIN; {@link RETIRED_KEYS_BY_MAJOR} and
 * {@link RETIRED_DEFS_BY_MAJOR} are keyed by major but are not read through it:
 * their consumer (`scripts/build-schemas.ts`) folds every major into one set.
 * Their rows leave on the same one-major clock as the tombstones they date —
 * see each table's "Lifecycle" — never because this constant moved.
 */
export const MIGRATION_SUPPORT_FLOOR = 17;

/**
 * One retirement's sentences in a step's `rationale` (#20535).
 *
 * The rationale renders as ONE paragraph — the upgrade guide prints it and
 * `migrate meta` shows it per hop — but an open major's is authored as
 * fragments, because every retirement of that major adds to it and one shared
 * string does not merge: each retirement PR rewrote its closing line.
 */
interface RationaleFragment {
  /**
   * Names the retirement: kebab-case, unique in its list, and its own D3
   * `semantic` entry id when it has one. The list is kept SORTED by this key.
   */
  readonly id: string;
  /** Where the fragment renders: ascending `order`, ties broken by `id`. */
  readonly order: number;
  /** The sentences, with no leading or trailing space: fragments join with one. */
  readonly text: string;
}

/** A rationale from its fragments: ascending `order` (ties by `id`), joined with one space. */
function joinRationale(fragments: readonly RationaleFragment[]): string {
  return [...fragments]
    .sort((a, b) => a.order - b.order || (a.id < b.id ? -1 : 1))
    .map((f) => f.text)
    .join(' ');
}

/**
 * Step 18's `rationale`, one fragment per retirement.
 *
 * ⚠️ SORTED BY `id`, NOT BY LANDING ORDER — that is the point of the shape.
 * Git reports a conflict whenever two branches insert into the SAME gap between
 * two unchanged lines, whatever they insert, and GitHub's server-side merge runs
 * no driver that could say otherwise. A list appended at its end is one gap, so
 * any two retirements in flight conflicted here, exactly as they did when this
 * was one `+` chain whose closing line each of them rewrote. Kept sorted by
 * key, two retirements insert into different gaps and merge clean — one
 * existing fragment between them is enough. `order`, not the position in this
 * list, says where a fragment renders.
 *
 * To add one: `id` is your retirement's D3 semantic entry id; insert the
 * fragment where that id sorts; `order` is one more than the highest here. Two
 * retirements in flight may both take the same number, and then render in `id`
 * order. `scripts/step18-rationale-merge.test.ts` holds the list sorted and
 * proves the merge.
 */
