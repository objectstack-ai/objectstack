{
  "name": "@objectstack/connector-app-stripe",
  "version": "0.1.1",
  "description": "Stripe connector app (open edition, read only): Stripe's OpenAPI document, trimmed offline to eight read operations, as a declarative `openapi` connector instance authenticated by a restricted secret key the administrator supplies through the credential store.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./objectstack.config.ts",
  "types": "./objectstack.config.ts",
  "exports": {
    ".": "./objectstack.config.ts",
    "./objectstack.config": "./objectstack.config.ts"
  },
  "scripts": {
    "build": "objectstack build",
    "validate": "objectstack validate",
    "typecheck": "tsc --noEmit",
    "test": "objectstack validate && vitest run"
  },
  "dependencies": {
    "@objectstack/connector-openapi": "workspace:*",
    "@objectstack/spec": "workspace:*"
  },
  "devDependencies": {
    "@objectstack/cli": "workspace:*",
    "@objectstack/verify": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
