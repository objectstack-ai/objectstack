{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    // Type-check this package's own code, not its dependencies' .d.ts. Without
    // it tsc re-checks all of @objectstack/spec's built declarations, which is
    // what took this program to ~4.4 GB peak RSS, against a 4136 MB CI heap.
    // tsconfig.base.json and every package extending it set the same flag.
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "types": [
      "node"
    ],
    "rootDir": "./src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
