// The workspace ROOT's own type-check program: `scripts/` and the top-level
// configs, everything outside packages/apps/examples/ui. It is NOT the shared
// base — packages extend `tsconfig.base.json` — so the Node environment below
// reaches this program and nothing else.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The scripts run on the Node that the root `engines` field pins (>=22),
    // which ships all of ES2022 (`Object.hasOwn` among it). The shared base
    // stays at ES2020.
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "packages",
    "apps",
    "examples",
    "ui"
  ]
}
