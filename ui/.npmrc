auto-install-peers=true

# Enforce the root `engines` range at install time instead of documenting it.
# Root package.json `engines` declares the node / pnpm floors (read them there;
# this comment does not restate them, so it cannot drift from them). Without
# this flag those are advisory and an unsupported toolchain fails later, in
# confusing ways. If this refused your install: upgrade node/pnpm to the
# declared floors. If it refused a Node version the declared floor ADMITS, a
# locked dependency's own `engines.node` sits above that floor: that is a repo
# defect, not your toolchain (objectui#11366), so report it.
engine-strict=true
