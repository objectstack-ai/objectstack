{
  "type": "card",
  "className": "max-w-md mx-auto",
  "header": [
    {
      "type": "stack",
      "gap": 2,
      "children": [
        {
          "type": "text",
          "content": "Confirm Deletion",
          "className": "text-lg font-semibold"
        },
        {
          "type": "text",
          "content": "Are you sure you want to delete this record? This action cannot be undone.",
          "className": "text-sm text-muted-foreground"
        }
      ]
    }
  ],
  "children": [
    {
      "type": "flex",
      "properties": {
        "justify": "end",
        "gap": 2,
        "children": [
          {
            "type": "button",
            "label": "Cancel",
            "variant": "outline"
          },
          {
            "type": "button",
            "label": "Yes, Delete",
            "variant": "destructive",
            "icon": "trash"
          }
        ]
      },
      "className": "pt-4"
    }
  ]
}
