{
  "name": "@object-ui/plugin-timeline",
  "version": "18.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Timeline component plugin for Object UI",
  "homepage": "https://www.objectui.org/docs/plugins/plugin-timeline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objectstack-ai/objectui.git",
    "directory": "packages/plugin-timeline"
  },
  "bugs": {
    "url": "https://github.com/objectstack-ai/objectui/issues"
  },
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --root ../.. packages/plugin-timeline/",
    "test:watch": "vitest --root ../.. packages/plugin-timeline/",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@object-ui/components": "workspace:*",
    "@object-ui/core": "workspace:*",
    "@object-ui/i18n": "workspace:*",
    "@object-ui/mobile": "workspace:*",
    "@object-ui/permissions": "workspace:*",
    "@object-ui/react": "workspace:*",
    "@object-ui/types": "workspace:*",
    "@objectstack/spec": "^18.0.0-next.1",
    "class-variance-authority": "^0.7.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@object-ui/data-objectstack": "workspace:*",
    "@object-ui/sdui-parser": "workspace:*",
    "@object-ui/test-support": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "keywords": [
    "objectui",
    "sdui",
    "schema-driven-ui",
    "react",
    "tailwind",
    "shadcn",
    "objectstack",
    "plugin",
    "timeline",
    "events",
    "history"
  ],
  "author": "ObjectStack Team <team@objectstack.ai>",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
