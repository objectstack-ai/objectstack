{
  "name": "@object-ui/plugin-chatbot",
  "version": "18.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Chatbot interface plugin for Object UI",
  "homepage": "https://www.objectui.org/docs/plugins/plugin-chatbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objectstack-ai/objectui.git",
    "directory": "packages/plugin-chatbot"
  },
  "bugs": {
    "url": "https://github.com/objectstack-ai/objectui/issues"
  },
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.core.config.ts",
    "test": "vitest run --root ../.. packages/plugin-chatbot/",
    "test:watch": "vitest --root ../.. packages/plugin-chatbot/",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.68",
    "@object-ui/components": "workspace:*",
    "@object-ui/core": "workspace:*",
    "@object-ui/i18n": "workspace:*",
    "@object-ui/react": "workspace:*",
    "@object-ui/types": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "@objectstack/spec": "^18.0.0-next.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "ai": "^7.0.65",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "shiki": "^4.4.2",
    "streamdown": "^2.5.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "keywords": [
    "objectui",
    "sdui",
    "schema-driven-ui",
    "react",
    "tailwind",
    "shadcn",
    "objectstack",
    "plugin",
    "chatbot",
    "ai",
    "chat",
    "conversation"
  ],
  "author": "ObjectStack Team <team@objectstack.ai>",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
