{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "noEmit": false,
    "declaration": true,
    // Kept outside `dist` (objectui#9189).
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "composite": true,
    "declarationMap": true
  },
  "include": ["src"],
  // Tooling excluded by directory (pnpm check:published-tsconfig-exclude).
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/__benchmarks__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
