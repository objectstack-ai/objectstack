{
  "name": "@object-ui/test-support",
  "version": "17.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Internal, never-published test-support modules shared by other packages' test suites",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./defaults-table-scan": "./src/defaults-table-scan.ts",
    "./hand-rolled-tables": "./src/hand-rolled-tables.json",
    "./zod-wrapper-keys": "./src/zod-wrapper-keys.json"
  },
  "scripts": {
    "test": "vitest run --root ../.. packages/test-support/",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@objectstack/spec": "workspace:^",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objectstack-ai/objectstack.git",
    "directory": "ui/packages/test-support"
  },
  "bugs": {
    "url": "https://github.com/objectstack-ai/objectui/issues"
  }
}
