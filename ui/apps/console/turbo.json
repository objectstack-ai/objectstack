{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "json-schema/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "**/*.tsbuildinfo",
        "!**/node_modules/**",
        "plugin.js",
        "plugin.d.ts"
      ],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/ui/packages/mobile/src/serviceWorkerSource.ts"]
    },
    "type-check": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/ui/packages/mobile/src/serviceWorkerSource.ts"]
    }
  }
}
